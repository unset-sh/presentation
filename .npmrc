engine-strict=true
save-exact=true
fund=false
# Resolve only versions published at least 7 days ago, so a hijacked release
# has time to be caught before it reaches us. Our own packages are exempt.
min-release-age=7
min-release-age-exclude[]=@unset-sh/*
# One-off exception, approved by Alex on 2026-11-21: @takumi-rs/core 2.22.1
# (published 2026-11-20) is the first release line that reports text no font
# can draw. Remove this exception on or after 2026-11-28.
min-release-age-exclude[]=@takumi-rs/core
min-release-age-exclude[]=@takumi-rs/core-*
min-release-age-exclude[]=@takumi-rs/helpers
# No dependency install scripts, locally or in CI.
ignore-scripts=true
