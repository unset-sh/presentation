{
  "name": "@unset-sh/rendering",
  "version": "0.1.0",
  "description": "Renders unset.sh preview images for profiles, posts and articles from supplied data.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unset-sh/rendering.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bun scripts/clean.ts dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run build && bun run test && bun .claude/agent-kit/sync.mjs --check",
    "gallery": "bun gallery/build.ts",
    "gallery:update": "bun gallery/build.ts --update"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@takumi-rs/core": "2.22.1",
    "@unset-sh/brand": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
